# --- Secrets / local machine overrides (never commit) ---
configs/api_keys.local.json
configs/common.local.json
configs/*.local.json
*.local.json
.env
.env.*

# --- Run artifacts ---
runs/
*.log

# --- Personal screenshots (never commit) ---
# Template crops that were captured manually rather than generated are excluded
# so no incidental desktop or game-overlay content can be redistributed.
PixPin_*.png
Screenshot_*.png
Screenshot_*.jpg

# --- Unused large assets ---
# Older navigation-map revisions and point-cloud exports are not needed to run
# the harness; the single map referenced by configs/common.json is shipped.
data/auto_nav_data/*.png
*.e57

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/
env/

